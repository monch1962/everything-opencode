// ========== INITIALIZATION ==========
// Initialize debug namespace
var debug = na
debug := true

// Display debug status
if barstate.islast and debugLevel > 0
    plotchar(debugLevel, "Debug Level: " + str.tostring(debugLevel), 
            location = location.top, size = size.tiny, color = color.new(color.blue, 0))