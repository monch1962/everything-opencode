// Generate report at the end
if barstate.islast and generateReport
    report = debug.generateCoverageReport()
    debug.log(report)
    
    // Generate test cases
    testSuite = debug.generateTestCases()
    debug.log("\n=== GENERATED TEST SUITE ===\n" + testSuite)
*/